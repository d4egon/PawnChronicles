<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!--
    Makes LuciferiumAddiction curable by the HealerMechSerum.
    Vanilla sets everCurableByItem=false to enforce the "no way out" feel,
    but PawnChronicles provides a hard-won narrative path to cure it.
    The HealerMechSerum targets "the single worst health condition" -
    with this patch, LuciferiumAddiction is eligible as that target.
  -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/HediffDef[defName="LuciferiumAddiction"]/everCurableByItem</xpath>
    <value>
      <everCurableByItem>true</everCurableByItem>
    </value>
  </Operation>
</Patch>
