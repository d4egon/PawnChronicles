<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    LUCIFER'S CARTEL PAWN KINDS
    All operators: BowlerHat + Duster over DevilstrandCloth pants + shirt.
    Dark charcoal uniform. High resistance/will - trained professionals who don't talk.
  -->

  <!-- ── OPERATOR - standard armed operative ──────────────────────────────── -->
  <PawnKindDef>
    <defName>PC_Cartel_Operator</defName>
    <label>operator</label>
    <race>Human</race>
    <defaultFactionType>PC_Faction_LucifersCartel</defaultFactionType>
    <combatPower>90</combatPower>
    <aiAvoidCover>false</aiAvoidCover>
    <initialResistanceRange>4~7</initialResistanceRange>
    <initialWillRange>3~6</initialWillRange>
    <skills>
      <li><skill>Shooting</skill><range>7~20</range></li>
    </skills>
    <weaponMoney>400~650</weaponMoney>
    <weaponTags>
      <li>IndustrialGunSimple</li>
      <li>IndustrialGunAdvanced</li>
    </weaponTags>
    <apparelRequired>
      <li>Apparel_BowlerHat</li>
      <li>Apparel_Duster</li>
      <li>Apparel_Pants</li>
      <li>Apparel_CollarShirt</li>
    </apparelRequired>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <apparelLayer>OnSkin</apparelLayer>
        <stuff>DevilstrandCloth</stuff>
      </li>
      <li>
        <bodyPartGroup>Legs</bodyPartGroup>
        <apparelLayer>OnSkin</apparelLayer>
        <stuff>DevilstrandCloth</stuff>
      </li>
    </specificApparelRequirements>
    <apparelColor>(0.15, 0.15, 0.15)</apparelColor>
    <apparelMoney>150~250</apparelMoney>
    <minGenerationAge>20</minGenerationAge>
    <maxGenerationAge>55</maxGenerationAge>
  </PawnKindDef>

