  <!--
    Lucifer's Cartel culture.
    Locks the faction to this name generator and appearance style.
  -->

  <CultureDef>
    <defName>PC_Culture_LuciferCartel</defName>
    <label>cartel</label>
    <description>The operational culture of Lucifer's Cartel. Controlled, professional, and deliberately unremarkable until they aren't.</description>
    <pawnNameMaker>PC_NamerPawn_LuciferCartel</pawnNameMaker>
    <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerIdeoKriminul</ideoNameMaker>
    <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerDeityRustican</deityNameMaker>
    <leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">LeaderTitleMaker_Kriminul</leaderTitleMaker>
    <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalKriminul</festivalNameMaker>
    <allowedPlaceTags>
      <li>OriginSpacer</li>
    </allowedPlaceTags>
    <iconPath>World/WorldObjects/Expanding/AncientMercenaries</iconPath>
    <styleItemTags>
      <li>
        <tag>Urban</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoBeard</tag>
        <baseWeight>6</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>BeardUrban</tag>
        <baseWeight>0.3</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
