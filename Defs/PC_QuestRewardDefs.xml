<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    ═══════════════════════════════════════════════════════════════════
    PAWNCHRONICLES REWARD DELIVERY UTILITIES
    ═══════════════════════════════════════════════════════════════════
    Each script pulls from a ThingSetMakerDef in PC_ThingSetMakerDefs.xml
    and delivers via drop pods to the player's map.

    Call from quest XML with:
      <li Class="QuestNode_SubScript">
        <def>PC_Util_Reward_LuciferiumLoot</def>
      </li>

    Required slate vars:
      $map        - player home map (set by QuestNode_GetMap earlier)
      $rewardValue - total market value target (set by Util_GetDefaultRewardValueFromPoints)
    ═══════════════════════════════════════════════════════════════════
  -->

  <!-- Expedition contact / facility reward: luciferium-focused contraband -->
  <QuestScriptDef>
    <defName>PC_Util_Reward_LuciferiumLoot</defName>
    <questDescriptionRules>
      <rulesStrings>
        <li>rewardDescription->transport pods with luciferium network supplies will arrive (value [rewardItemsTotalMarketValue_money])</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>

        <li Class="QuestNode_MultiplyRange">
          <range>0.8~1.2</range>
          <value>$rewardValue</value>
          <storeAs>rewardValueRange</storeAs>
        </li>

        <li Class="QuestNode_GenerateThingSet">
          <thingSetMaker>PC_Luciferium_QuestLoot</thingSetMaker>
          <totalMarketValueRange>$rewardValueRange</totalMarketValueRange>
          <storeAs>rewardItems</storeAs>
          <qualityGenerator>Reward</qualityGenerator>
        </li>

        <li Class="QuestNode_GetMarketValue">
          <things>$rewardItems</things>
          <storeAs>rewardItemsTotalMarketValue</storeAs>
        </li>

        <li Class="QuestNode_DropPods">
          <contents>$rewardItems</contents>
          <canRetargetAnyMap>true</canRetargetAnyMap>
          <customLetterLabel>$customLetterLabel</customLetterLabel>
          <customLetterText>$customLetterText</customLetterText>
          <customLetterLabelRules>$customLetterLabelRules</customLetterLabelRules>
          <customLetterTextRules>$customLetterTextRules</customLetterTextRules>
        </li>

      </nodes>
    </root>
  </QuestScriptDef>


